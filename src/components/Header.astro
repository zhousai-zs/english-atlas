---
import { url } from '../lib/url';
---

<header class="header">
  <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="sidebar">目录</button>
  <a class="brand" href={url('')}>
    <span class="seal" aria-hidden="true">英</span>
    <span>
      <span class="brand-name">英语地图</span>
      <span class="brand-en">English Atlas</span>
    </span>
  </a>
  <form class="search" action={url('search')} method="get" role="search">
    <label class="sr-only" for="site-search">搜索课程</label>
    <input id="site-search" name="q" type="search" placeholder="搜索，按 / 聚焦" autocomplete="off" />
  </form>
  <div class="header-actions">
    <a class="icon-btn" href={url('progress')}>进度</a>
    <button class="icon-btn" id="theme-toggle" type="button" aria-pressed="false">深色</button>
  </div>
</header>
