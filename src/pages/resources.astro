---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { loadCatalog } from '../lib/catalog';
import { url } from '../lib/url';

const catalog = await loadCatalog();
const { Content } = await render(catalog.resources);
---

<Base title={catalog.resources.data.title} description={catalog.resources.data.summary} current="resources" wide>
  <nav class="crumbs" aria-label="面包屑"><ol><li><a href={url('')}>首页</a></li><li aria-current="page">学习资料</li></ol></nav>
  <p class="eyebrow">Resources</p>
  <h1>{catalog.resources.data.title}</h1>
  <p class="lede">{catalog.resources.data.summary}</p>
  <div class="prose"><Content /></div>
  <div class="filters" role="group" aria-label="按费用或阶段筛选">
    <button type="button" data-filter="all" aria-pressed="true">全部</button>
    <button type="button" data-filter="免费">免费</button>
    <button type="button" data-filter="部分免费">部分免费</button>
    <button type="button" data-filter="付费">付费</button>
    <button type="button" data-filter="入门">入门</button>
    <button type="button" data-filter="初级">初级</button>
    <button type="button" data-filter="中级">中级</button>
    <button type="button" data-filter="进阶">进阶</button>
    <button type="button" data-filter="全程">全程</button>
  </div>
  {catalog.resources.data.groups.map((group) => (
    <section class="resource-group">
      <h2>{group.title}</h2>
      <p>{group.intro}</p>
      {group.items.map((item) => (
        <article class="resource" data-cost={item.cost} data-stage={item.stage}>
          <h3><a href={item.url} rel="noopener noreferrer">{item.name}</a></h3>
          <p class="host">{new URL(item.url).host}</p>
          <p class="card-meta"><span class="chip">{item.cost}</span> <span class="chip chip-warm">{item.stage}</span></p>
          <p>{item.note}</p>
        </article>
      ))}
    </section>
  ))}
</Base>
