---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StudyLesson from '../../components/StudyLesson.astro';
import { loadCatalog, mustGet, neighbors } from '../../lib/catalog';
import { pad, url } from '../../lib/url';

export async function getStaticPaths() {
  const { grammar } = await loadCatalog();
  return grammar.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const catalog = await loadCatalog();
const { Content } = await render(entry);
const { prev, next } = neighbors(catalog.grammar, entry.id, 'grammar');
const prerequisites = entry.data.prerequisites.map((ref) => mustGet(catalog.links, ref));
---

<Base title={entry.data.title} description={entry.data.summary} current={`grammar:${entry.id}`}>
  <StudyLesson
    crumbs={[{ href: url(''), label: '首页' }, { href: url('grammar'), label: '语法' }]}
    eyebrow={`语法 · ${entry.data.group} · ${pad(entry.data.order)}`}
    title={entry.data.title}
    titleEn={entry.data.titleEn}
    summary={entry.data.summary}
    level={entry.data.level}
    minutes={entry.data.minutes}
    lessonId={`grammar:${entry.id}`}
    formula={entry.data.formula}
    examples={entry.data.examples}
    mistakes={entry.data.mistakes}
    recap={entry.data.recap}
    quiz={entry.data.quiz}
    prerequisites={prerequisites}
    prev={prev}
    next={next}
  >
    <Content />
  </StudyLesson>
</Base>
