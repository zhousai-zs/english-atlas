---
import Base from '../../layouts/Base.astro';
import CardList from '../../components/CardList.astro';
import { groupBy, loadCatalog } from '../../lib/catalog';
import { pad, url } from '../../lib/url';

const { grammar } = await loadCatalog();
const groups = groupBy(grammar);
---

<Base title="语法" description="从名词、冠词和时态，到从句、非谓语、虚拟语气和强调倒装的系统语法课。" current="grammar" wide>
  <nav class="crumbs" aria-label="面包屑"><ol><li><a href={url('')}>首页</a></li><li aria-current="page">语法</li></ol></nav>
  <p class="eyebrow">Grammar</p>
  <h1>语法</h1>
  <p class="lede">共 {grammar.length} 课，按词法、时态与语态、句法排列。每课都先讲规则，再给形式、例句、易错点、小结和 5 题练习。零基础请从第 1 课按顺序走。</p>
  {groups.map((group) => (
    <section>
      <h2>{group.name}</h2>
      <CardList
        items={group.items.map((item) => ({
          ref: `grammar:${item.id}`,
          href: url(`grammar/${item.id}`),
          index: pad(item.data.order),
          title: item.data.title,
          titleEn: item.data.titleEn,
          meta: `${item.data.level} · 约 ${item.data.minutes} 分钟`,
          summary: item.data.summary,
        }))}
      />
    </section>
  ))}
</Base>
